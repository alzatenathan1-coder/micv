---
import { capabilities } from '../../data/content';
import ChapterLabel from '../ChapterLabel.astro';
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="capacidades" data-chapter="Capacidades" class="border-y border-ink-200 bg-white">
  <div class="container-x py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <ChapterLabel title="Capacidades" />
        <h2 class="h-section mt-3 max-w-[22ch] text-ink-950">Capacidades, con la prueba al lado</h2>
      </div>
      <p class="max-w-[46ch] text-[0.95rem] leading-relaxed text-ink-600">
        Qué sé hacer, con qué herramientas y dónde comprobarlo: cada línea remite a un proyecto publicado,
        una acreditación o una experiencia concreta.
      </p>
    </div>

    <ol class="mt-12 border-t border-ink-950">
      {capabilities.map((c, i) => (
        <li class="grid gap-5 border-b border-ink-200 py-9 lg:grid-cols-[3rem_minmax(0,5fr)_minmax(0,3fr)_minmax(0,4fr)] lg:gap-8">
          <span class="font-mono text-[0.8rem] tabular-nums text-ink-600">{pad(i + 1)}</span>
          <div>
            <h3 class="h-display text-[clamp(1.25rem,2.2vw,1.7rem)] font-semibold leading-[1.12] text-ink-950" style="text-wrap:balance">{c.title}</h3>
            <p class="mt-2.5 max-w-[46ch] text-[0.97rem] leading-relaxed text-ink-600">{c.body}</p>
          </div>
          <div>
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-600">Herramientas</p>
            <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-800">{c.skills.join(' · ')}</p>
          </div>
          <div>
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-600">Dónde se ve</p>
            <ul class="mt-2 flex flex-col gap-1.5 text-[0.88rem] leading-snug">
              {c.evidence.map(e => (
                <li>{e.href
                  ? <a href={e.href} class="link-underline text-brand-700">{e.label}</a>
                  : <span class="text-ink-800">{e.label}</span>}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
