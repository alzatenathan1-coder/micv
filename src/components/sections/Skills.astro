---
import { skills } from '../../data/site';

const groups = [
  { key: 'dev',      title: 'Tecnologías de desarrollo', items: skills.dev,      icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' },
  { key: 'systems',  title: 'Sistemas y plataformas',    items: skills.systems,  icon: '<rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>' },
  { key: 'teaching', title: 'Competencias docentes',     items: skills.teaching, icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>' },
];

const toneMap = {
  native: 'bg-brand-800 text-white border-brand-800',
  mid:    'bg-gold-500/10 text-gold-600 border-gold-500/30',
  low:    'bg-ink-100 text-ink-600 border-ink-200',
};
---
<section id="habilidades" class="py-20 md:py-28 bg-white">
  <div class="container-x">
    <div class="max-w-3xl mb-12">
      <p class="reveal eyebrow">Habilidades e idiomas</p>
      <h2 class="reveal reveal-delay-1 h-section mt-4 text-3xl md:text-4xl text-ink-950">
        Stack profesional
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {groups.map((g, i) => (
        <article class={`reveal reveal-delay-${(i % 4) + 1} card p-6`}>
          <div class="flex items-center gap-3 pb-4 border-b border-ink-100">
            <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-100 text-brand-700 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon}></svg>
            </div>
            <h3 class="h-display text-lg text-ink-950">{g.title}</h3>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {g.items.map(s => (<span class="chip">{s}</span>))}
          </div>
        </article>
      ))}

      <article class="reveal reveal-delay-4 card p-6">
        <div class="flex items-center gap-3 pb-4 border-b border-ink-100">
          <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-100 text-brand-700 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3 class="h-display text-lg text-ink-950">Idiomas</h3>
        </div>
        <ul class="mt-4 divide-y divide-ink-100">
          {skills.languages.map(l => (
            <li class="flex items-center justify-between py-3">
              <span class="text-ink-700 font-medium">{l.name}</span>
              <span class={`text-[0.72rem] font-semibold px-2.5 py-1 rounded-full border ${toneMap[l.tone as keyof typeof toneMap] ?? toneMap.low}`}>{l.level}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>
