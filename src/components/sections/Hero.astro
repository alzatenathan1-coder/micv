---
import type { Profile } from '../../data/content';
interface Props { profile: Profile }
const { profile: p } = Astro.props;
---
<section class="relative overflow-hidden border-b border-ink-100">
  <div class="container-x grid gap-12 py-16 md:py-24 lg:grid-cols-[1.55fr_1fr] lg:items-end">
    <div class="max-w-[46ch] lg:max-w-none">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="h-display mt-5 text-[clamp(2rem,5.2vw,3.4rem)] font-semibold leading-[1.06] tracking-[-0.02em] text-ink-950" style="text-wrap:balance">
        {p.h1}
      </h1>
      <div class="mt-7 flex max-w-[64ch] flex-col gap-4 text-[1.03rem] leading-relaxed text-ink-600">
        {p.intro.map(t => <p>{t}</p>)}
      </div>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={p.ctaPrimary.href} class="btn btn-primary">{p.ctaPrimary.label}</a>
        {p.ctaSecondary && <a href={p.ctaSecondary.href} class="btn btn-ghost">{p.ctaSecondary.label}</a>}
      </div>
    </div>

    <!-- Bloque-tesis desplazado: rompe la simetría del hero centrado -->
    <aside class="relative lg:-mb-6">
      <div class="rounded-xl rounded-tl-sm border border-ink-100 bg-white/70 p-6 shadow-sm md:p-7">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-brand-600">Por qué yo</p>
        <p class="mt-3 text-[0.98rem] leading-relaxed text-ink-800">{p.claim}</p>
      </div>
    </aside>
  </div>
</section>
