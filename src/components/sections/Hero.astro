---
import { site } from '../../data/site';
---
<section id="inicio" class="relative overflow-hidden pt-28 pb-20 md:pt-36 md:pb-28 bg-grain">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute -top-32 -right-40 w-[32rem] h-[32rem] rounded-full bg-brand-100 blur-3xl opacity-60"></div>
    <div class="absolute -bottom-40 -left-32 w-[28rem] h-[28rem] rounded-full bg-gold-300/30 blur-3xl opacity-40"></div>
  </div>

  <div class="container-x relative">
    <div class="grid md:grid-cols-[1.15fr_0.85fr] gap-10 md:gap-16 items-center">
      <div>
        <span class="reveal chip !bg-white/80 !border-ink-200 !text-ink-600" style="animation-delay:0s">
          <span class="dot-live"></span>
          Impartiendo ahora · Curso Java 210 h
        </span>

        <h1 class="reveal reveal-delay-1 h-display mt-5 text-4xl sm:text-5xl md:text-6xl text-ink-950">
          <span class="block text-ink-950">Docente técnico IT</span>
          <span class="block text-brand-700">Formador homologado SEPE</span>
        </h1>

        <p class="reveal reveal-delay-2 mt-5 text-ink-600 text-lg leading-relaxed max-w-[38rem]">
          Analista Programador con acreditación oficial
          <strong class="text-ink-950">SSCE0110 · Sobresaliente S-8</strong>.
          Experiencia real en Java, bases de datos y gestión de plataformas formativas (FUNDAE, FOCO, Moodle).
          Colaboro con centros de FP y empresas que necesitan formadores técnicos con rigor y metodología actual.
        </p>

        <div class="reveal reveal-delay-3 mt-8 flex flex-wrap gap-3">
          <a href="#contacto" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Colaborar con tu centro
          </a>
          <a href={`mailto:${site.email}?subject=${encodeURIComponent('Solicitud de CV docente — Natanael Alzate')}&body=${encodeURIComponent('Hola Natanael,\n\nSoy [nombre] de [centro]. Nos interesaría recibir tu CV completo para una posible colaboración docente.\n\nGracias.')}`} class="btn btn-ghost">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6 12 13 2 6"/></svg>
            Solicitar CV docente
          </a>
        </div>

        <ul class="reveal reveal-delay-4 mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-500">
          <li class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Cuenca · Castilla-La Mancha · Remoto
          </li>
          <li class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/></svg>
            Contrato laboral · Autónomo · Acuerdo marco
          </li>
        </ul>
      </div>

      <div class="relative mx-auto md:mx-0 w-full max-w-sm reveal reveal-delay-2">
        <div class="relative aspect-[4/5] rounded-2xl overflow-hidden ring-1 ring-ink-100 shadow-[var(--shadow-lg)] bg-white">
          <img src={site.photo} alt={`${site.name} — ${site.role}`} class="w-full h-full object-cover object-top" loading="eager" />
          <div class="absolute inset-x-4 bottom-4 flex flex-wrap gap-2">
            <span class="chip !bg-white !border-ink-200 !text-ink-700"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> SEPE SSCE0110 · S-8</span>
            <span class="chip !bg-brand-800 !border-brand-800 !text-white">Disponible · 2026</span>
          </div>
        </div>

        <div class="absolute -top-5 -right-5 hidden md:flex w-24 h-24 rounded-2xl rotate-6 bg-white shadow-[var(--shadow-md)] items-center justify-center">
          <div class="text-center leading-tight">
            <p class="text-[0.65rem] uppercase tracking-widest text-ink-400">Java</p>
            <p class="h-display text-2xl text-brand-700">210h</p>
            <p class="text-[0.65rem] text-ink-400">en activo</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
