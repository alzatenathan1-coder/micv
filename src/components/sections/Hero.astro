---
import type { Profile } from '../../data/content';
import { site } from '../../data/site';
interface Props { profile: Profile }
const { profile: p } = Astro.props;
// id="home" en la portada: destino de los créditos «Desarrollado por Nathan Torres» de las webs de clientes.
const stats = p.stats ?? [];
---
<section id={p.slug === 'home' ? 'home' : 'inicio'} class="relative border-b border-ink-200">
  <div class="hero-grid container-x w-full pt-10 pb-16 md:py-24">
    <div class="hero-copy max-w-[46ch] lg:max-w-none">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="h-display mt-5 text-[clamp(2rem,4.6vw,3.3rem)] font-semibold leading-[1.06] tracking-[-0.02em] text-ink-950" style="text-wrap:balance">
        {p.h1}
      </h1>
      <div class="mt-7 flex max-w-[64ch] flex-col gap-4 text-[1.03rem] leading-relaxed text-ink-600">
        {p.intro.map(t => <p>{t}</p>)}
      </div>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={p.ctaPrimary.href} class="btn btn-primary">{p.ctaPrimary.label}</a>
        {p.ctaSecondary && <a href={p.ctaSecondary.href} class="btn btn-ghost">{p.ctaSecondary.label}</a>}
      </div>
      {stats.length > 0 && (
        <dl class="mt-10 grid max-w-[42rem] grid-cols-2 border-t border-ink-200 sm:grid-cols-4">
          {stats.map(s => (
            <div class="flex flex-col-reverse gap-1 border-b border-ink-200 py-4 pr-4 sm:border-b-0">
              <dt class="text-[0.8rem] leading-snug text-ink-600">{s.label}</dt>
              <dd class="h-display text-[1.9rem] font-semibold tabular-nums text-ink-950">{s.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <!-- Retrato: arco de marca y la cabeza rompe el marco por arriba -->
    <div class="hero-visual">
    <figure class="hero-portrait">
      <span class="hp-outline" aria-hidden="true"></span>
      <span class="hp-arch" aria-hidden="true"></span>
      <picture>
        <source type="image/avif" srcset="/img/retrato-400.avif 400w, /img/retrato-660.avif 660w" sizes="(min-width: 1024px) 460px, 280px" />
        <source type="image/webp" srcset="/img/retrato-400.webp 400w, /img/retrato-660.webp 660w" sizes="(min-width: 1024px) 460px, 280px" />
        <img
          src="/img/retrato-660.webp" alt={`Retrato de ${site.name}`}
          width="660" height="740" loading="eager" decoding="async" fetchpriority="high"
          class="hp-img"
        />
      </picture>
      <figcaption class="hp-tag panel">
        <span class="block text-[0.86rem] font-semibold leading-tight text-ink-950">{site.name}</span>
        <span class="block font-mono text-[0.64rem] uppercase tracking-[0.12em] text-ink-600">Cuenca · remoto</span>
      </figcaption>
    </figure>

    <aside class="hero-claim">
      <div class="panel rounded-sm p-5 md:p-6">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-brand-600">Por qué yo</p>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-800">{p.claim}</p>
      </div>
    </aside>
    </div>
  </div>

  <!-- Recorte del retrato en unidades relativas: cúpula del arco + franja superior para la cabeza -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <clipPath id="hp-clip" clipPathUnits="objectBoundingBox">
      <rect x="0" y="0" width="1" height="0.36" />
      <path d="M0,1 L0,0.686 A0.5,0.446 0 0 1 1,0.686 L1,1 Z" />
    </clipPath>
  </svg>

</section>
