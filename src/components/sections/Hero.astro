---
import type { Profile } from '../../data/content';
import { site } from '../../data/site';
interface Props { profile: Profile }
const { profile: p } = Astro.props;
// id="home" en la portada: destino de los créditos «Desarrollado por Nathan Torres» de las webs de clientes.
const animated = Boolean(p.rotating?.length && p.h1Lead);
// Cifras: «250 h» -> contador 0→250 + sufijo; los años arrancan desde 2000.
const stats = (p.stats ?? []).map(s => {
  const m = s.value.match(/^(\d+)(.*)$/);
  const to = m ? Number(m[1]) : null;
  return { ...s, to, from: to && to > 1900 ? 2000 : 0, suffix: m ? m[2] : '' };
});
---
<section
  id={p.slug === 'home' ? 'home' : 'inicio'}
  data-chapter="Inicio" data-chapter-skip
  class:list={['relative overflow-hidden border-b border-ink-100', animated && 'lg:flex lg:min-h-[calc(100svh-4rem)] lg:items-center lg:pb-16']}
>
  <div class="hero-grid container-x w-full pt-10 pb-16 md:py-24">
    <div class="hero-copy max-w-[46ch] lg:max-w-none">
      <p class="eyebrow hero-in" style="--d:0">{p.eyebrow}</p>
      {animated ? (
        <h1 class="h-display mt-5 text-[clamp(2.1rem,4.4vw,3.5rem)] font-semibold leading-[1.04] tracking-[-0.03em] text-ink-950">
          <span class="sr-only">{p.h1}</span>
          <span aria-hidden="true" class="block">
            <span class="hero-in block" style="--d:1">{p.h1Lead}</span>
            <span class="rotator hero-in" style="--d:2" data-rotator>
              {p.rotating!.map((r, i) => <span class:list={['rotator-item text-gradient', i === 0 && 'is-on']}>{r}</span>)}
            </span>
          </span>
        </h1>
      ) : (
        <h1 class="h-display hero-in mt-5 text-[clamp(2rem,5.2vw,3.4rem)] font-semibold leading-[1.06] tracking-[-0.02em] text-ink-950" style="--d:1;text-wrap:balance">
          {p.h1}
        </h1>
      )}
      <div class="hero-in mt-7 flex max-w-[64ch] flex-col gap-4 text-[1.03rem] leading-relaxed text-ink-600" style="--d:3">
        {p.intro.map(t => <p>{t}</p>)}
      </div>
      <div class="hero-in mt-9 flex flex-wrap items-center gap-3" style="--d:4">
        <a href={p.ctaPrimary.href} class="btn btn-primary">{p.ctaPrimary.label}</a>
        {p.ctaSecondary && <a href={p.ctaSecondary.href} class="btn btn-ghost">{p.ctaSecondary.label}</a>}
      </div>
      {stats.length > 0 && (
        <dl class="hero-in mt-10 grid max-w-[42rem] grid-cols-2 gap-x-8 gap-y-5 border-t border-ink-100 pt-6 sm:grid-cols-4" style="--d:5">
          {stats.map(s => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-[0.8rem] leading-snug text-ink-600">{s.label}</dt>
              <dd class="h-display text-[1.9rem] font-semibold tabular-nums text-ink-950">
                {s.to !== null
                  ? <><span data-ticker data-to={s.to} data-from={s.from}>{s.to}</span>{s.suffix}</>
                  : s.value}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <!-- Retrato: arco de marca y la cabeza rompe el marco por arriba -->
    <div class="hero-visual">
    <figure class="hero-portrait hero-in" style="--d:1" data-tilt>
      <span class="hp-outline" aria-hidden="true"></span>
      <span class="hp-arch" aria-hidden="true"></span>
      <picture>
        <source type="image/avif" srcset="/img/retrato-400.avif 400w, /img/retrato-660.avif 660w" sizes="(min-width: 1024px) 460px, 280px" />
        <source type="image/webp" srcset="/img/retrato-400.webp 400w, /img/retrato-660.webp 660w" sizes="(min-width: 1024px) 460px, 280px" />
        <img
          src="/img/retrato-660.webp" alt={`Retrato de ${site.name}`}
          width="660" height="740" loading="eager" decoding="async" fetchpriority="high"
          class="hp-img"
        />
      </picture>
      <figcaption class="hp-tag glass">
        <span class="hp-tag-dot" aria-hidden="true"></span>
        <span>
          <span class="block text-[0.86rem] font-semibold leading-tight text-ink-950">{site.name}</span>
          <span class="block font-mono text-[0.64rem] uppercase tracking-[0.12em] text-ink-600">Cuenca · remoto</span>
        </span>
      </figcaption>
    </figure>

    <aside class="hero-claim hero-in" style="--d:6">
      <div class="glass rounded-2xl rounded-tl-sm p-5 md:p-6">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-brand-600">Por qué yo</p>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-800">{p.claim}</p>
      </div>
    </aside>
    </div>
  </div>

  <!-- Recorte del retrato en unidades relativas: cúpula del arco + franja superior para la cabeza -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <clipPath id="hp-clip" clipPathUnits="objectBoundingBox">
      <rect x="0" y="0" width="1" height="0.36" />
      <path d="M0,1 L0,0.686 A0.5,0.446 0 0 1 1,0.686 L1,1 Z" />
    </clipPath>
  </svg>

  {animated && (
    <a href="#showcase" class="scroll-cue hero-in" style="--d:7" aria-label="Bajar al primer capítulo">
      <span>Desliza · empieza la historia</span>
      <span class="scroll-cue-line" aria-hidden="true"></span>
    </a>
  )}
</section>
