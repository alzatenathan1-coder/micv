---
import { site } from '../../data/site';

const channels = [
  {
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6 12 13 2 6"/>',
  },
  {
    label: 'Teléfono',
    value: site.phone,
    href: `tel:${site.phoneHref}`,
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/natanaelalzate',
    href: site.linkedin,
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: 'Ubicación',
    value: `${site.location} · Remoto`,
    href: null,
    icon: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
  },
];
---
<section id="contacto" class="py-20 md:py-28 bg-white border-t border-ink-100">
  <div class="container-x">
    <div class="grid md:grid-cols-[0.45fr_0.55fr] gap-12 lg:gap-20 items-start">

      <div>
        <p class="reveal eyebrow">Hablemos</p>
        <h2 class="reveal reveal-delay-1 h-section mt-4 text-3xl md:text-5xl text-ink-950">
          ¿Tu centro necesita un docente técnico para 2026?
        </h2>
        <p class="reveal reveal-delay-2 mt-5 text-ink-600 text-lg leading-relaxed max-w-[32rem]">
          Respondo el mismo día hábil. Tras el primer contacto envío documentación
          acreditativa completa y CV adaptado al puesto.
        </p>

        <ul class="reveal reveal-delay-3 mt-10 space-y-4">
          {channels.map(c => (
            <li class="flex items-start gap-4">
              <span class="shrink-0 w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon}></svg>
              </span>
              <div class="min-w-0">
                <p class="text-[0.72rem] uppercase tracking-widest text-ink-400">{c.label}</p>
                {c.href ? (
                  <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined} class="block mt-0.5 text-ink-950 font-medium break-words hover:text-brand-700 transition-colors">{c.value}</a>
                ) : (
                  <p class="mt-0.5 text-ink-950 font-medium">{c.value}</p>
                )}
              </div>
            </li>
          ))}
        </ul>

        <div class="reveal reveal-delay-4 mt-10 flex flex-wrap gap-3">
          <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-whatsapp">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
            WhatsApp directo
          </a>
        </div>
      </div>

      <form
        class="reveal reveal-delay-2 rounded-2xl border border-ink-100 bg-ink-50/60 p-6 md:p-8 shadow-[var(--shadow-sm)]"
        method="POST"
        action={`mailto:${site.email}`}
        enctype="text/plain"
      >
        <p class="eyebrow !text-ink-400">Formulario para centros</p>
        <p class="h-display text-xl md:text-2xl mt-3 text-ink-950">Cuéntame la necesidad formativa</p>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="block text-[0.78rem] font-medium text-ink-700 mb-1.5">Tu nombre</span>
            <input
              name="nombre"
              required
              class="w-full rounded-lg bg-white border border-ink-200 px-3.5 py-2.5 text-ink-950 placeholder:text-ink-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition"
              placeholder="Ej. Mariana García"
            />
          </label>
          <label class="block">
            <span class="block text-[0.78rem] font-medium text-ink-700 mb-1.5">Centro / empresa</span>
            <input
              name="centro"
              required
              class="w-full rounded-lg bg-white border border-ink-200 px-3.5 py-2.5 text-ink-950 placeholder:text-ink-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition"
              placeholder="Ej. Centro de FP Cuenca"
            />
          </label>
          <label class="block sm:col-span-2">
            <span class="block text-[0.78rem] font-medium text-ink-700 mb-1.5">Email de contacto</span>
            <input
              type="email"
              name="email"
              required
              class="w-full rounded-lg bg-white border border-ink-200 px-3.5 py-2.5 text-ink-950 placeholder:text-ink-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition"
              placeholder="mariana@centrofp.es"
            />
          </label>
          <label class="block sm:col-span-2">
            <span class="block text-[0.78rem] font-medium text-ink-700 mb-1.5">Necesidad formativa</span>
            <textarea
              name="mensaje"
              rows="4"
              required
              class="w-full rounded-lg bg-white border border-ink-200 px-3.5 py-2.5 text-ink-950 placeholder:text-ink-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition resize-y"
              placeholder="Ej. buscamos docente para CP IFCD0210 de septiembre a diciembre 2026."
            ></textarea>
          </label>
        </div>

        <label class="mt-4 flex items-start gap-2.5 text-[0.8rem] text-ink-500">
          <input type="checkbox" required class="mt-0.5 accent-brand-600" />
          <span>Acepto el tratamiento de mis datos para esta consulta. No se ceden a terceros.</span>
        </label>

        <button type="submit" class="mt-6 btn btn-primary !w-full !justify-center">
          Enviar consulta
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
        <p class="mt-3 text-[0.75rem] text-ink-400 text-center">
          Abre tu cliente de correo con la consulta preparada.
        </p>
      </form>

    </div>
  </div>
</section>
