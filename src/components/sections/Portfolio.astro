---
import { projects } from '../../data/content';
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
---
<section id="trabajo" class="container-x py-20 md:py-24">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <h2 class="h-section text-ink-950">Trabajo seleccionado</h2>
    <p class="max-w-[42ch] text-[0.95rem] leading-relaxed text-ink-600">
      Cuatro proyectos en producción: identidad, contenido, código y páginas listas para vender.
    </p>
  </div>

  <div class="mt-12 flex flex-col gap-14">
    {projects.map((p, i) => (
      <article class:list={['reveal grid gap-7 md:items-center', detailed ? 'md:grid-cols-2' : 'md:grid-cols-[1fr_1.1fr]']}>
        <a
          href={p.url}
          rel="noopener"
          class:list={['group block overflow-hidden rounded-xl border border-ink-100 bg-white', i % 2 === 1 && 'md:order-2']}
        >
          <img
            src={p.img}
            alt={`Captura del proyecto ${p.name}`}
            width="1200" height="800" loading="lazy" decoding="async"
            class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </a>

        <div class:list={[i % 2 === 1 && 'md:order-1']}>
          <p class="font-mono text-[0.74rem] uppercase tracking-[0.12em] text-brand-600">{p.sector}</p>
          <h3 class="h-display mt-2 text-[1.35rem] font-semibold text-ink-950">{p.name}</h3>

          {detailed ? (
            <dl class="mt-4 flex flex-col gap-3 text-[0.93rem] leading-relaxed">
              <div><dt class="font-semibold text-ink-800">Reto</dt><dd class="text-ink-600">{p.reto}</dd></div>
              <div><dt class="font-semibold text-ink-800">Solución</dt><dd class="text-ink-600">{p.solucion}</dd></div>
              <div><dt class="font-semibold text-ink-800">Stack</dt><dd class="text-ink-600">{p.stack}</dd></div>
              <div><dt class="font-semibold text-ink-800">Resultado</dt><dd class="text-ink-600">{p.resultado}</dd></div>
            </dl>
          ) : (
            <p class="mt-3 max-w-[54ch] text-[0.95rem] leading-relaxed text-ink-600">{p.resultado}</p>
          )}

          <a href={p.url} rel="noopener" class="btn btn-ghost mt-5 text-[0.85rem]">Ver web publicada</a>
        </div>
      </article>
    ))}
  </div>
</section>
