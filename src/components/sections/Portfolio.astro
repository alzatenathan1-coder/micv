---
import { projects, type Project } from '../../data/content';
import Shot from '../Shot.astro';
import ChapterLabel from '../ChapterLabel.astro';
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
const live = (p: Project) => p.status === 'En producción';
---
<section id="trabajo" data-chapter="Proyectos" class="container-x py-20 md:py-28">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <ChapterLabel title="Proyectos" />
      <h2 class="h-section mt-3 text-ink-950">{detailed ? 'Proyecto a proyecto' : 'Webs publicadas'}</h2>
    </div>
    <p class="max-w-[44ch] text-[0.95rem] leading-relaxed text-ink-600">
      {projects.length} webs para clientes reales. Cada ficha enlaza a la web publicada.
    </p>
  </div>

  {detailed ? (
    <div class="mt-12 flex flex-col gap-20">
      {projects.map((p, i) => (
        <article id={p.slug} class="grid gap-8 md:grid-cols-2 md:items-start md:gap-12">
          <Shot project={p} aspect="aspect-[4/5]" class:list={['md:sticky md:top-24', i % 2 === 1 && 'md:order-2']} />

          <div class:list={[i % 2 === 1 && 'md:order-1']}>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.74rem] uppercase tracking-[0.12em] text-brand-600">
              <span>{p.sector}</span>
              <span class="text-ink-600">{live(p) ? 'Publicada' : p.status}</span>
            </p>
            <h3 class="h-display mt-2 text-[1.5rem] font-semibold text-ink-950">{p.name}</h3>

            <dl class="mt-5 flex flex-col gap-4 text-[0.94rem] leading-relaxed">
              <div><dt class="font-semibold text-ink-800">Reto</dt><dd class="mt-0.5 text-ink-600">{p.reto}</dd></div>
              <div><dt class="font-semibold text-ink-800">Solución</dt><dd class="mt-0.5 text-ink-600">{p.solucion}</dd></div>
              {p.destacados && (
                <div>
                  <dt class="font-semibold text-ink-800">Qué incluye</dt>
                  <dd class="mt-1.5">
                    <ul class="flex flex-col gap-2 text-ink-600">
                      {p.destacados.map(d => (
                        <li class="border-b border-ink-200 py-2 first:border-t">{d}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
              <div><dt class="font-semibold text-ink-800">Stack</dt><dd class="mt-0.5 text-ink-600">{p.stack}</dd></div>
              <div><dt class="font-semibold text-ink-800">Resultado</dt><dd class="mt-0.5 border-l-2 border-brand-200 pl-3 text-ink-700">{p.resultado}</dd></div>
            </dl>

            <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tecnologías">
              {p.tags.map(t => <li class="chip">{t}</li>)}
            </ul>
            {p.proximamente
              ? <p class="mt-6 font-mono text-[0.78rem] text-ink-400">Próximamente en {new URL(p.url).host}</p>
              : <a href={p.url} rel="noopener" class="btn btn-ghost mt-6 text-[0.85rem]">Ver web publicada ↗</a>}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <>
      <ol class="mt-12 border-t border-ink-950">
        {projects.map((p, i) => (
          <li id={p.slug} class="grid gap-6 border-b border-ink-200 py-10 md:grid-cols-[3rem_minmax(0,5fr)_minmax(0,6fr)] md:gap-10">
            <span class="font-mono text-[0.8rem] tabular-nums text-ink-600">{String(i + 1).padStart(2, '0')}</span>
            <div class="flex flex-col">
              <p class="font-mono text-[0.72rem] uppercase tracking-[0.1em] text-ink-600">{p.sector}</p>
              <h3 class="h-display mt-2 text-[clamp(1.5rem,2.6vw,2.1rem)] font-semibold leading-[1.08] text-ink-950">{p.name}</h3>
              <p class="mt-3 max-w-[50ch] text-[0.96rem] leading-relaxed text-ink-600">{p.resumen}</p>
              <p class="mt-4 text-[0.82rem] text-ink-600">{p.tags.join(' · ')}</p>
              <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.88rem] font-medium">
                {p.proximamente
                  ? <span class="text-ink-600">Próximamente en {new URL(p.url).host}</span>
                  : <a href={p.url} rel="noopener" class="btn btn-ghost text-[0.84rem]">Ver web publicada ↗</a>}
                <a href={`/casos#${p.slug}`} class="link-underline text-ink-700">Caso completo</a>
              </p>
            </div>
            <Shot project={p} aspect="aspect-[4/3]" />
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-col gap-5 border-l-2 border-brand-700 pl-6 md:flex-row md:items-center md:justify-between">
        <p class="max-w-[56ch] text-[1rem] leading-relaxed text-ink-700">
          ¿Tienes un proyecto parecido? Cuéntame qué tiene que conseguir tu web (reservas, contactos, catálogo o captación B2B) y te digo cómo la plantearía, con qué tecnología y en qué plazo.
        </p>
        <p class="flex shrink-0 flex-wrap gap-3">
          <a href="#contacto" class="btn btn-primary">Contar mi proyecto</a>
          <a href="/casos" class="btn btn-ghost">Ver todos los casos</a>
        </p>
      </div>
    </>
  )}
</section>
