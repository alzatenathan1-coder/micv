---
import ChapterLabel from '../ChapterLabel.astro';
import { projects } from '../../data/content';
const p = projects[0];
const host = new URL(p.url).host;
---
<section id="showcase" data-chapter="Lo que construyo" class="container-x py-20 md:py-28">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-14">
    <div>
      <ChapterLabel title="Lo que construyo" />
      <h2 class="h-section mt-3 text-ink-950">{p.name}, la web más reciente</h2>
      <p class="mt-4 max-w-[48ch] text-[1rem] leading-relaxed text-ink-600">{p.resumen}</p>
      {p.destacados && (
        <ul class="mt-6 flex flex-col border-t border-ink-200 text-[0.92rem] leading-relaxed text-ink-700">
          {p.destacados.map(d => <li class="border-b border-ink-200 py-3">{d}</li>)}
        </ul>
      )}
      <p class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href={p.url} rel="noopener" class="btn btn-primary">Abrir {host} ↗</a>
        <a href={`/casos#${p.slug}`} class="link-underline text-[0.9rem] font-medium text-ink-700">Caso completo</a>
      </p>
    </div>

    <figure class="border border-ink-300 bg-white">
      <a href={p.url} rel="noopener" class="block h-[26rem] overflow-hidden md:h-[34rem]" aria-label={`Abrir ${p.name} (${host})`}>
        <img
          src="/img/portfolio/logistikos-showcase.webp"
          alt={`Página de inicio de ${p.name}`}
          width="1200" height="5000" loading="lazy" decoding="async"
          class="w-full"
        />
      </a>
      <figcaption class="flex items-center justify-between gap-4 border-t border-ink-300 px-4 py-2.5 font-mono text-[0.72rem] text-ink-600">
        <span>{host}</span>
        <span>Captura de la portada publicada</span>
      </figcaption>
    </figure>
  </div>
</section>
