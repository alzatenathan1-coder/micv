---
import { about } from '../../data/content';
import { site } from '../../data/site';
---
<section id="sobre-mi" class="border-y border-ink-100 bg-white/50">
  <div class="container-x grid gap-12 py-20 md:py-24 lg:grid-cols-[1.5fr_1fr]">
    <div>
      <h2 class="h-section text-ink-950">{about.heading}</h2>
      <div class="mt-7 flex max-w-[66ch] flex-col gap-4 text-[1rem] leading-relaxed text-ink-600">
        {about.paragraphs.map(t => <p>{t}</p>)}
      </div>
    </div>

    <div class="lg:pt-4">
      <img
        src={site.photo} alt={site.name}
        width="480" height="480" loading="lazy" decoding="async"
        class="mb-7 w-40 rounded-xl rounded-br-sm border border-ink-100 object-cover"
      />
      <dl class="flex flex-col gap-px overflow-hidden rounded-lg border border-ink-100 bg-ink-100">
        {about.data.map(d => (
          <div class="flex items-baseline gap-4 bg-ink-50 px-4 py-2.5">
            <dt class="w-24 shrink-0 font-mono text-[0.72rem] uppercase tracking-[0.1em] text-ink-400">{d.k}</dt>
            <dd class="text-[0.9rem] text-ink-800">{d.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
