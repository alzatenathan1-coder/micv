---
import { timeline, formacion } from '../../data/content';
import { facts } from '../../data/site';
import ChapterLabel from '../ChapterLabel.astro';
---
<section id="trayectoria" data-chapter="Trayectoria" class="border-y border-ink-200 bg-white">
  <div class="container-x py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <ChapterLabel title="Trayectoria" />
        <h2 class="h-section mt-3 max-w-[22ch] text-ink-950">Trayectoria desde {facts.anosDesde}</h2>
      </div>
      <p class="max-w-[40ch] text-[0.95rem] leading-relaxed text-ink-600">
        Del backend de televisión interactiva en Praga al aula y a la consultoría. Desde 2017 sin salir del terreno técnico.
      </p>
    </div>

    <div class="tl relative mt-14">
      <span class="tl-rail" aria-hidden="true"></span>
      <ol class="flex flex-col gap-14 md:gap-24">
        {timeline.map(t => (
          <li class="relative grid gap-3 pl-10 md:grid-cols-[14rem_1fr] md:gap-12 md:pl-16">
            <span class="tl-dot" aria-hidden="true"></span>
            <div class="md:sticky md:top-28 md:self-start">
              <p class="tl-year h-display">{t.years}</p>
              <p class="mt-1.5 text-[0.85rem] font-medium text-ink-400">{t.org}</p>
            </div>
            <div class="max-w-[66ch]">
              <h3 class="h-display text-[1.2rem] font-semibold leading-snug text-ink-950">{t.role}</h3>
              <p class="mt-2.5 text-[0.97rem] leading-relaxed text-ink-600">{t.body}</p>
              <p class="mt-3 border-l-2 border-brand-300 pl-3 text-[0.92rem] leading-relaxed text-ink-700">{t.result}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <h3 class="h-display mt-20 text-[1.15rem] font-semibold text-ink-950">Formación y acreditaciones</h3>
    <dl class="mt-6 grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {formacion.map(f => (
        <div class:list={['border-t border-ink-200 pt-4', f.badge && 'relative pr-20']}>
          <dt class="flex items-baseline gap-3">
            <span class="shrink-0 font-mono text-[0.75rem] tabular-nums text-brand-600">{f.year}</span>
            <span class="h-display text-[0.98rem] font-semibold text-ink-950">{f.title}</span>
            {f.badge && <img src={f.badge} alt="" width="56" height="56" loading="lazy" decoding="async" class="absolute right-0 top-4 size-14" />}
          </dt>
          <dd class="mt-1.5 max-w-[52ch] text-[0.9rem] leading-relaxed text-ink-600">{f.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .tl-rail {
    position: absolute;
    top: .6rem;
    bottom: .6rem;
    left: 5px;
    width: 1px;
    background: var(--color-ink-300);
  }
  .tl-dot {
    position: absolute;
    left: 0;
    top: .55rem;
    width: 11px;
    height: 11px;
    background: var(--color-brand-700);
  }
  .tl-year {
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-brand-700);
  }
</style>
