---
import ChapterLabel from '../ChapterLabel.astro';
interface Props { text: string }
const { text } = Astro.props;
---
<section id="enfoque" data-chapter="Cómo trabajo" class="container-x py-20 md:py-28">
  <div class="grid gap-6 border-t border-ink-950 pt-8 lg:grid-cols-[14rem_1fr] lg:gap-12">
    <ChapterLabel title="Cómo trabajo" class="self-start" />
    <p class="h-display max-w-[30ch] text-[clamp(1.6rem,3.4vw,2.6rem)] font-medium leading-[1.18] text-ink-950">{text}</p>
  </div>
</section>
