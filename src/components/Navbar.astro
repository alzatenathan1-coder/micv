---
import { site } from '../data/site';

const links = [
  { href: '#sobre-mi',   label: 'Sobre mí' },
  { href: '#curso-java', label: 'Curso Java' },
  { href: '#servicios',  label: 'Servicios' },
  { href: '#trayectoria',label: 'Trayectoria' },
  { href: '#formacion',  label: 'Formación' },
  { href: '#contacto',   label: 'Contacto' },
];
---

<header id="nx-navbar" class="fixed top-0 inset-x-0 z-50 -translate-y-full opacity-0 transition-all duration-500 [transition-timing-function:var(--ease-out-expo)]" data-state="hidden">
  <div class="container-x">
    <div class="mt-3 flex items-center justify-between gap-4 rounded-2xl border border-ink-100 bg-white/85 px-4 py-2.5 backdrop-blur-md shadow-[var(--shadow-sm)]">
      <a href="#inicio" class="flex items-center gap-3 group" aria-label={`Inicio — ${site.name}`}>
        <img src={site.photo} alt="" class="w-9 h-9 rounded-full object-cover object-top ring-2 ring-brand-200" loading="eager" />
        <span class="flex flex-col leading-tight">
          <span class="h-display text-[0.95rem] text-brand-800">{site.name}</span>
          <span class="text-[0.7rem] text-ink-400">{site.role}</span>
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
        {links.map(l => (
          <a href={l.href} class="nx-nav-link px-3 py-2 text-[0.85rem] font-medium text-ink-600 rounded-lg transition-colors hover:text-brand-700 hover:bg-brand-50">{l.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a href="#contacto" class="hidden sm:inline-flex btn btn-primary !py-2 !px-4 !text-[0.82rem]">Colaborar</a>
        <button id="nx-nav-toggle" class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-ink-200 text-ink-600 hover:bg-brand-50" aria-controls="nx-nav-mobile" aria-expanded="false" aria-label="Abrir menú">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </button>
      </div>
    </div>

    <nav id="nx-nav-mobile" class="lg:hidden hidden mt-2 rounded-2xl border border-ink-100 bg-white/95 backdrop-blur-md p-2 shadow-[var(--shadow-md)]" aria-label="Menú móvil">
      {links.map(l => (
        <a href={l.href} class="nx-nav-link block px-4 py-3 text-sm font-medium text-ink-700 rounded-lg hover:bg-brand-50 hover:text-brand-700">{l.label}</a>
      ))}
    </nav>
  </div>
</header>
