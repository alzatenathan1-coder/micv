---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-ink-100 bg-white">
  <div class="container-x py-10 grid gap-8 md:grid-cols-3">
    <div>
      <p class="h-display text-lg text-brand-800">{site.name}</p>
      <p class="text-sm text-ink-400 mt-1">{site.role}</p>
      <p class="text-sm text-ink-400 mt-4">{site.location}</p>
    </div>
    <div>
      <p class="eyebrow">Contacto</p>
      <ul class="mt-3 space-y-1 text-sm text-ink-600">
        <li><a href={`mailto:${site.email}`} class="hover:text-brand-700">{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`} class="hover:text-brand-700">{site.phone}</a></li>
        <li><a href={site.whatsapp} target="_blank" rel="noopener" class="hover:text-brand-700">WhatsApp</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noopener" class="hover:text-brand-700">LinkedIn</a></li>
      </ul>
    </div>
    <div class="text-sm text-ink-400 md:text-right">
      <p>&copy; {year} <strong class="text-ink-700">{site.name}</strong></p>
      <p class="mt-2">Web-CV v2 · Astro + Tailwind</p>
      <p class="mt-2">Todos los datos y acreditaciones son reales y verificables bajo solicitud.</p>
    </div>
  </div>
</footer>
