---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-ink-100 bg-white/60">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <p class="h-display text-lg font-semibold text-ink-950">{site.name}</p>
      <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-600">
        Analista programador y docente técnico acreditado. Cuenca y remoto.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={`mailto:${site.email}`} class="btn btn-ghost text-[0.82rem]">Escríbeme</a>
        <a href={site.whatsapp} class="btn btn-whatsapp text-[0.82rem]" rel="noopener">WhatsApp</a>
      </div>
    </div>

    <nav aria-label="Secciones">
      <p class="eyebrow">Perfiles</p>
      <ul class="mt-3 flex flex-col gap-1.5">
        {nav.map(n => (
          <li><a href={n.href} class="text-[0.9rem] text-ink-600 transition-colors hover:text-brand-700">{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="eyebrow">Contacto y legal</p>
      <ul class="mt-3 flex flex-col gap-1.5 text-[0.9rem] text-ink-600">
        <li><a href={`mailto:${site.email}`} class="transition-colors hover:text-brand-700">{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`} class="transition-colors hover:text-brand-700">{site.phone}</a></li>
        <li><a href={site.linkedin} rel="noopener me" class="transition-colors hover:text-brand-700">{site.linkedinHandle}</a></li>
        <li class="pt-2"><a href="/aviso-legal" class="transition-colors hover:text-brand-700">Aviso legal</a></li>
        <li><a href="/privacidad" class="transition-colors hover:text-brand-700">Política de privacidad</a></li>
      </ul>
    </div>
  </div>

  <div class="container-x border-t border-ink-100 py-5">
    <p class="font-mono text-[0.72rem] tracking-wide text-ink-400">
      © {year} {site.name} · Cuenca, España
    </p>
  </div>
</footer>
