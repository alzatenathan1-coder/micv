---
import type { Project } from '../data/content';
interface Props {
  project: Project;
  /** Clase de proporción del marco, p. ej. aspect-[3/2]. */
  aspect?: string;
  class?: string;
}
const { project: p, aspect = 'aspect-[3/2]', class: extra } = Astro.props;
// Captura con el dominio real al pie.
// En escritorio, al pasar el ratón la captura se desplaza y muestra la página entera (.shot).
const host = new URL(p.url).host;
const Tag = p.proximamente ? 'div' : 'a';
// width/height coherentes con el marco para reservar el hueco sin saltos de maquetación.
const [rw, rh] = (aspect.match(/\[(\d+)\/(\d+)\]/)?.slice(1) ?? ['3', '2']).map(Number);
const w = 960;
const h = Math.round((w * rh) / rw);
---
<Tag
  {...(p.proximamente ? {} : { href: p.url, rel: 'noopener', 'aria-label': `Abrir ${p.name} (${host})` })}
  class:list={['group flex flex-col overflow-hidden border border-ink-300 bg-white', extra]}
>
  <img
    src={p.img}
    alt={`Captura de la web ${p.name}`}
    width={w} height={h} loading="lazy" decoding="async"
    class:list={['shot w-full object-cover', aspect]}
  />
  <span class="border-t border-ink-300 px-3 py-2 font-mono text-[0.7rem] text-ink-600">{host}{p.proximamente && ' · próximamente'}</span>
</Tag>
