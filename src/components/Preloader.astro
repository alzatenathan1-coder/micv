---
---
<div id="nx-preloader" class="fixed inset-0 z-[9999] flex items-center justify-center" aria-hidden="true">
  <div class="relative flex flex-col items-center px-6">
    <!-- Marco animado + nombre completo -->
    <div class="nx-pre-brand">
      <svg viewBox="0 0 360 120" class="nx-pre-svg" aria-hidden="true" role="img">
        <defs>
          <linearGradient id="nxpreG" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--nxpre-g1)" />
            <stop offset="1" stop-color="var(--nxpre-g2)" />
          </linearGradient>
        </defs>
        <rect
          x="6" y="6" width="348" height="108" rx="14"
          fill="none"
          stroke="url(#nxpreG)"
          stroke-width="1.4"
          class="nx-pre-frame"
        />
        <text
          x="180" y="70"
          text-anchor="middle"
          dominant-baseline="middle"
          font-family="Fraunces, Georgia, serif"
          font-weight="500"
          font-size="42"
          letter-spacing="-1.2"
          class="nx-pre-name"
        >Natanael</text>
      </svg>
    </div>

    <!-- Barra de progreso -->
    <div class="nx-pre-track">
      <div id="nx-pre-bar" class="nx-pre-bar"></div>
    </div>

    <p class="nx-pre-sub">Alzate Torres · Docente técnico IT</p>
  </div>
</div>

<style>
  /* Tokens base (claro sobre fondo oscuro). Si el sistema prefiere dark,
     intensificamos contraste y oscurecemos el fondo. */
  #nx-preloader {
    --nxpre-bg: #0F1E2A;
    --nxpre-text: #ffffff;
    --nxpre-sub: rgba(207, 235, 238, 0.72);
    --nxpre-track: rgba(255, 255, 255, 0.10);
    --nxpre-g1: #1796A3;
    --nxpre-g2: #5EBDC6;

    background: var(--nxpre-bg);
    color: var(--nxpre-text);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.6s;
  }

  @media (prefers-color-scheme: dark) {
    #nx-preloader {
      --nxpre-bg: #050B11;
      --nxpre-sub: rgba(158, 215, 220, 0.72);
      --nxpre-track: rgba(255, 255, 255, 0.08);
      --nxpre-g1: #2FA0AD;
      --nxpre-g2: #9ED7DC;
    }
  }

  #nx-preloader.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .nx-pre-brand {
    width: min(86vw, 360px);
  }
  .nx-pre-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .nx-pre-name {
    fill: var(--nxpre-text);
    opacity: 0;
    animation: nx-text-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
  }
  .nx-pre-frame {
    stroke-dasharray: 920;
    stroke-dashoffset: 920;
    animation: nx-frame-draw 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .nx-pre-track {
    margin-top: 1.6rem;
    width: min(72vw, 240px);
    height: 2px;
    background: var(--nxpre-track);
    border-radius: 999px;
    overflow: hidden;
  }
  .nx-pre-bar {
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: linear-gradient(to right, var(--nxpre-g1), var(--nxpre-g2));
    animation: nx-bar-fill 1.25s cubic-bezier(0.4, 0, 0.2, 1) 0.1s forwards;
  }

  .nx-pre-sub {
    margin-top: 1.1rem;
    font-family: "Inter Variable", system-ui, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--nxpre-sub);
    text-align: center;
  }

  @keyframes nx-frame-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes nx-text-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes nx-bar-fill {
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nx-pre-frame, .nx-pre-name, .nx-pre-bar {
      animation: none;
    }
    .nx-pre-frame { stroke-dashoffset: 0; }
    .nx-pre-name { opacity: 1; }
    .nx-pre-bar { transform: scaleX(1); }
  }
</style>
