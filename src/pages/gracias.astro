---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Mensaje recibido" description="Tu mensaje ha llegado correctamente. Te respondo en menos de 24 horas.">
  <section class="container-x max-w-[56ch] py-24 md:py-32">
    <p class="eyebrow">Formulario enviado</p>
    <h1 class="h-display mt-5 text-[clamp(1.9rem,4.5vw,2.8rem)] font-semibold tracking-[-0.02em] text-ink-950">
      Mensaje recibido
    </h1>
    <p class="mt-6 text-[1.05rem] leading-relaxed text-ink-600">
      Te respondo en menos de 24 horas al correo que has indicado. Si el asunto corre prisa,
      escríbeme directamente por WhatsApp y lo vemos antes.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={site.whatsapp} rel="noopener" class="btn btn-whatsapp">WhatsApp</a>
      <a href="/" class="btn btn-ghost">Volver al inicio</a>
    </div>
  </section>
</Base>
