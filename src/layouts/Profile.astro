---
import Base from './Base.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Extras from '../components/sections/Extras.astro';
import Process from '../components/sections/Process.astro';
import Timeline from '../components/sections/Timeline.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Showcase from '../components/sections/Showcase.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import About from '../components/sections/About.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import CrossLinks from '../components/sections/CrossLinks.astro';
import type { Profile } from '../data/content';

interface Props { profile: Profile }
const { profile: p } = Astro.props;
const detailed = p.slug === 'casos';
// La portada se cuenta como historia: producto real, enfoque, proyectos,
// herramientas, capacidades, servicios, trayectoria, persona y contacto.
const story = Boolean(p.portfolioFirst);
---
<Base title={p.title} description={p.description} personSchema={p.slug === 'home'} hasContact>
  <Hero profile={p} />
  {!story && <CrossLinks links={p.crossLinks} />}
  {story && <Showcase />}
  {story && p.manifesto && <Manifesto text={p.manifesto} />}
  {story && p.showPortfolio && <Portfolio detailed={detailed} />}
  {story && p.showCapabilities && <Capabilities />}
  <Services items={p.services} note={p.servicesNote} />
  {p.extras && <Extras heading={p.extras.heading} items={p.extras.items} />}
  {p.process && <Process steps={p.process} />}
  {!story && p.showPortfolio && <Portfolio detailed={detailed} />}
  {!story && p.showCapabilities && <Capabilities />}
  {p.showTimeline && <Timeline />}
  {p.showAbout && <About />}
  {p.faq && <Faq items={p.faq} />}
  {story && <CrossLinks links={p.crossLinks} />}
  {!story && !p.showTimeline && !p.showPortfolio && (
    <section class="container-x pb-16 md:pb-20">
      <p class="border-t border-ink-100 pt-6 text-[0.95rem] leading-relaxed text-ink-600">
        Mi trayectoria completa y quién hay detrás están en la portada:
        <a href="/#trayectoria" class="link-underline text-brand-700">Trayectoria desde 2017</a> ·
        <a href="/#sobre-mi" class="link-underline text-brand-700">Sobre mí</a> ·
        <a href="/casos" class="link-underline text-brand-700">Proyectos publicados</a>.
      </p>
    </section>
  )}
  <Contact />
</Base>
